diff --git a/packages/app/src/providers/models/health-rpc.ts b/packages/app/src/providers/models/health-rpc.ts
new file mode 100644
index 0000000000..109c29f306
--- /dev/null
+++ b/packages/app/src/providers/models/health-rpc.ts
@@ -0,0 +1,42 @@
+import { Schema } from "effect"
+import { Rpc } from "@opencode/schema/rpc"
+
+// Mirror of the `model-health` plugin contract (opencode-plugins/packages/model-health/src/rpc.ts).
+// The server side is provided by that plugin; without it the selector simply shows no health state.
+export const Reason = Schema.Literals([
+  "not_found",
+  "unsupported",
+  "configuration",
+  "authentication",
+  "rate_limit",
+  "quota",
+  "provider",
+  "timeout",
+  "network",
+  "unknown",
+])
+
+export const Health = Schema.Struct({
+  status: Schema.Literals(["available", "unavailable", "unknown"]),
+  checkedAt: Schema.Number,
+  latencyMs: Schema.optional(Schema.Number),
+  reason: Schema.optional(Reason),
+})
+export type Health = typeof Health.Type
+
+export const Definition = Rpc.define({
+  id: "model-health",
+  methods: {
+    check: {
+      input: Schema.toStandardSchemaV1(
+        Schema.Struct({
+          providerID: Schema.String,
+          modelID: Schema.String,
+          force: Schema.optional(Schema.Boolean),
+        }),
+      ),
+      output: Schema.toStandardSchemaV1(Health),
+    },
+  },
+  events: {},
+})
diff --git a/packages/app/src/providers/models/health.test.ts b/packages/app/src/providers/models/health.test.ts
new file mode 100644
index 0000000000..e39b47af1d
--- /dev/null
+++ b/packages/app/src/providers/models/health.test.ts
@@ -0,0 +1,49 @@
+import { afterEach, expect, mock, setSystemTime, test } from "bun:test"
+import { createRoot } from "solid-js"
+
+const request = mock(async () => ({ status: "available" as const, checkedAt: Date.now() }))
+const rpc = mock((definition: { id: string }) => ({ id: definition.id, check: request }))
+
+mock.module("@/runtime/server/client", () => ({
+  useServerSDK: () => ({ scope: "health-test", api: { rpc } }),
+}))
+
+mock.module("@/workspaces/location", () => ({
+  useWorkspaceLocation: () => () => ({ ref: { directory: "/health-test" } }),
+}))
+
+const { createModelHealth } = await import("./health")
+
+afterEach(() => setSystemTime())
+
+// Owns the UI contract: a probe goes through the model-health plugin RPC and
+// updates only the exact model that was checked.
+test("model health is scoped to the checked model", async () => {
+  const root = createRoot((dispose) => ({ health: createModelHealth(), dispose }))
+  expect(request).not.toHaveBeenCalled()
+  expect(root.health.result("gateway", "opus")).toBeUndefined()
+  await root.health.check("gateway", "opus")
+  expect(rpc.mock.results[0]?.value).toMatchObject({ id: "model-health" })
+  expect(request).toHaveBeenCalledWith(
+    { providerID: "gateway", modelID: "opus", force: undefined },
+    { location: { directory: "/health-test" } },
+  )
+  expect(root.health.result("gateway", "opus")?.status).toBe("available")
+  expect(root.health.result("relay", "opus")).toBeUndefined()
+  expect(root.health.result("gateway", "sonnet")).toBeUndefined()
+  expect(root.health.checking()).toBe(false)
+  root.dispose()
+})
+
+test("stops probing when the server has no model-health plugin", async () => {
+  request.mockImplementationOnce(async () => {
+    throw { type: "rpc.unavailable", message: "RPC is unavailable: model-health" }
+  })
+  const root = createRoot((dispose) => ({ health: createModelHealth(), dispose }))
+  await root.health.check("missing", "model")
+  expect(root.health.supported()).toBe(false)
+  const calls = request.mock.calls.length
+  await root.health.checkAll([{ id: "other", provider: { id: "missing" } }])
+  expect(request.mock.calls.length).toBe(calls)
+  root.dispose()
+})
diff --git a/packages/app/src/providers/models/health.tsx b/packages/app/src/providers/models/health.tsx
new file mode 100644
index 0000000000..a5e64315e6
--- /dev/null
+++ b/packages/app/src/providers/models/health.tsx
@@ -0,0 +1,138 @@
+import { createEffect, onCleanup } from "solid-js"
+import { createStore } from "solid-js/store"
+import { useServerSDK } from "@/runtime/server/client"
+import { useWorkspaceLocation } from "@/workspaces/location"
+import { useLanguage } from "@/runtime/i18n/language"
+import { Definition, type Health as ModelHealth } from "./health-rpc"
+
+type ModelTarget = {
+  readonly id: string
+  readonly provider: {
+    readonly id: string
+  }
+}
+
+const [results, setResults] = createStore<Record<string, ModelHealth | undefined>>({})
+
+const [pending, setPending] = createStore<Record<string, boolean | undefined>>({})
+
+const inflight = new Map<string, Promise<void>>()
+
+// Servers without the model-health plugin answer with one of these; stop probing them.
+const missing = new Set(["rpc.unavailable", "rpc.method_not_found"])
+
+const [unsupported, setUnsupported] = createStore<Record<string, boolean | undefined>>({})
+
+const errorType = (error: unknown) =>
+  typeof error === "object" && error !== null && "type" in error && typeof error.type === "string"
+    ? error.type
+    : undefined
+
+export function createModelHealth() {
+  const sdk = useServerSDK()
+  const location = useWorkspaceLocation()
+  const [store, setStore] = createStore({ now: Date.now() })
+
+  const key = (providerID: string, modelID: string) =>
+    JSON.stringify([sdk.scope, location().ref, providerID, modelID])
+
+  createEffect(() => {
+    const timer = setInterval(() => setStore("now", Date.now()), 10000)
+    onCleanup(() => clearInterval(timer))
+  })
+
+  const scope = () => JSON.stringify([sdk.scope, location().ref])
+
+  const supported = () => !unsupported[scope()]
+
+  const result = (providerID: string, modelID: string) => {
+    const value = results[key(providerID, modelID)]
+
+    return value && store.now - Number(value.checkedAt) < 60000 ? value : undefined
+  }
+
+  const check = (providerID: string, modelID: string, options?: { force?: boolean }) => {
+    const target = key(providerID, modelID)
+
+    if (!supported()) return Promise.resolve()
+    if (!options?.force && result(providerID, modelID)) return Promise.resolve()
+    const existing = inflight.get(target)
+
+    if (existing) return existing
+
+    setPending(target, true)
+
+    const current = scope()
+    const task = sdk.api
+      .rpc(Definition)
+      .check({ providerID, modelID, force: options?.force }, { location: location().ref })
+      .then((response) => setResults(target, response))
+      .catch((error: unknown) => {
+        const type = errorType(error)
+
+        if (type && missing.has(type)) return setUnsupported(current, true)
+        setResults(target, { status: "unavailable", checkedAt: Date.now(), reason: "network" })
+      })
+      .finally(() => {
+        inflight.delete(target)
+        setPending(target, undefined)
+        setStore("now", Date.now())
+      })
+
+    inflight.set(target, task)
+
+    return task
+  }
+
+  const checkAll = async (items: readonly ModelTarget[], options?: { force?: boolean }) => {
+    if (!supported()) return
+    const queue = items.filter((item) => options?.force || !result(item.provider.id, item.id))
+
+    if (queue.length === 0) return
+    let index = 0
+
+    const worker = async () => {
+      while (index < queue.length) {
+        const current = queue[index]
+        index += 1
+
+        if (current) await check(current.provider.id, current.id, options)
+      }
+    }
+
+    await Promise.all([worker(), worker()])
+  }
+
+  return {
+    supported,
+    checking: () => Object.values(pending).some(Boolean),
+    pending: (providerID: string, modelID: string) => Boolean(pending[key(providerID, modelID)]),
+    result,
+    check,
+    checkAll,
+  }
+}
+
+export function ModelHealthIndicator(props: { result?: ModelHealth; pending?: boolean }) {
+  const language = useLanguage()
+  const status = () => props.result?.status ?? (props.pending ? "checking" : "unknown")
+
+  const label = () => {
+    if (props.pending && !props.result) return language.t("model.health.checking")
+    const current = props.result?.status ?? "unknown"
+    const text = language.t(`model.health.${current}`)
+
+    if (!props.result) return text
+
+    const detail = language.t("model.health.detail", {
+      status: text,
+      time: new Date(Number(props.result.checkedAt)).toLocaleTimeString(),
+    })
+
+    return props.result.reason
+      ? `${detail} · ${language.t(`model.health.reason.${props.result.reason}`)}`
+      : detail
+  }
+
+  return <span class="model-health-indicator" data-status={status()} role="img" aria-label={label()} title={label()} />
+}
