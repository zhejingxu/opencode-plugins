{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext",
      "DOM"
    ]
  },
  "include": [
    "packages/*/*.ts",
    "packages/*/test/**/*.ts"
  ]
}
